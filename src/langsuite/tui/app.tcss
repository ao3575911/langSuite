Screen { layout: vertical; }
HeaderBar { height: 1; background: $panel; }
HeaderBar > Static { width: auto; padding: 0 1; }
#handle { color: $accent; width: 1fr; text-style: bold; }
#mode { color: $secondary; text-style: bold; }
#base { color: $text-muted; }
#body { height: 1fr; }
#nav { width: 16; border-right: solid $primary 40%; }
#nav > ListItem { padding: 0 1; }
#main { width: 1fr; }
.pane { padding: 1 2; }
.pane-title { text-style: bold; color: $primary; margin-bottom: 1; }
.pane-status { color: $warning; margin: 1 0; }
.pane-cmds { color: $text-muted; }
#leader { dock: bottom; height: 1; display: none; background: $secondary 30%; padding: 0 1; }
#leader.-active { display: block; }
.-plain #nav { border-right: none; }
.-plain DataTable, .-plain Input, .-plain TabbedContent { border: none; }
.explore { padding: 0 1; }
#explore-search { margin: 0 0 0 0; }
#explore-status { color: $text-muted; height: auto; padding: 0 1; }
#explore-status.-error { color: $warning; }
#explore-body { height: 1fr; }
#explore-table { width: 50%; max-width: 62; }
#explore-tabs { width: 3fr; }
#explore-tabs Static { padding: 0 1; }
.querypane { padding: 0 1; }
#query-input.-invalid { border: tall $error; }
#query-status { color: $text-muted; height: auto; padding: 0 1; }
#query-status.-error { color: $warning; }
#query-table { height: 1fr; }
#query-help { color: $text-muted; height: auto; padding: 0 1; }
.workspacepane { padding: 0 1; }
#ws-status { color: $text-muted; height: auto; padding: 0 1; }
#ws-status.-error { color: $warning; }
#ws-body { height: 1fr; }
#ws-findings { width: 50%; max-width: 50; }
#ws-tabs { width: 3fr; }
#ws-tabs Static { padding: 0 1; }
#ws-help { color: $text-muted; height: auto; padding: 0 1; }
